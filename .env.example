# Production deploy only. Neon Postgres URL. Never commit a real value.
# PowerShell: $env:DATABASE_URL = "postgresql://..."; bun run deploy
# The command stores it as the Worker secret DATABASE_URL and migrates the direct (non-pooler) host.
DATABASE_URL=

# Frontend (public; never place secrets in PUBLIC_* variables)
PUBLIC_API_ORIGIN=http://localhost:8787
# Origin used for canonical URLs, og:url, and the sitemap. No production domain is final yet (PRD §16),
# so it stays unset by default: the build then emits no canonical/sitemap instead of a guessed host.
# Set the real origin (scheme + host only, no path or trailing slash), e.g. https://jagadaerah.id
PUBLIC_SITE_URL=

# Local API/Hyperdrive development only. Use a non-production database and the read-only role.
# Wrangler requires a password in this URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://jaga_readonly:change-me@127.0.0.1:5432/jaga_daerah

# Schema migrations (`bun run db:migrate`). Use the migration/owner role, never the runtime role.
# Non-local hosts additionally require --confirm-target=<host>:<port>/<database>.
MIGRATION_DATABASE_URL=postgres://jaga_migrator:change-me@127.0.0.1:5432/jaga_daerah

# ETL local development only. Use a separate role from the API runtime role.
ETL_DATABASE_URL=postgres://jaga_etl:change-me@127.0.0.1:5432/jaga_daerah

