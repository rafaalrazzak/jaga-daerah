{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jaga-daerah-api",
  "main": "src/index.ts",
  // Must not be newer than the workerd release bundled with the pinned Wrangler (1.20261012.1).
  "compatibility_date": "2026-10-12",
  // Required by `pg` (Node net/tls APIs) behind the Drizzle client.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Exact browser origins allowed by CORS. Local Astro, plus the Pages project from `bun run deploy`.
    "CORS_ALLOWED_ORIGINS": "http://localhost:4321,https://jaga-daerah.pages.dev",
  },
  // Local `wrangler dev` only. Production deploy uses the DATABASE_URL secret, so a placeholder
  // Hyperdrive id is not sent to Cloudflare.
  "env": {
    "local": {
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
