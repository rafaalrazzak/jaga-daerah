{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jaga-daerah-api",
  "main": "src/index.ts",
  // Must not be newer than the workerd release bundled with the pinned Wrangler (1.20261012.1).
  "compatibility_date": "2026-10-12",
  // Required by `pg` (Node net/tls APIs) behind the Drizzle client.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Exact browser origins allowed by CORS. Production/preview values are set per environment.
    "CORS_ALLOWED_ORIGINS": "http://localhost:4321",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder until a Hyperdrive config is provisioned (Milestone 7). Local development and
      // tests supply CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
      "id": "00000000000000000000000000000000",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
}
