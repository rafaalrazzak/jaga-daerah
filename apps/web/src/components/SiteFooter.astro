---
import Logo from '@/components/Logo.astro';

const columns = [
  {
    title: 'Jelajahi',
    links: [
      { href: '/#indonesia-sekarang', label: 'Kondisi terkini' },
      { href: '/#peta', label: 'Peta' },
      { href: '/#panduan', label: 'Cara membaca' },
      { href: '/bandingkan', label: 'Bandingkan daerah' },
      { href: '/#cari', label: 'Pilih daerah' },
    ],
  },
  {
    title: 'Data',
    links: [
      { href: '/sumber', label: 'Semua sumber' },
      { href: '/sumber#keuangan', label: 'Keuangan daerah' },
      { href: '/sumber#penduduk', label: 'Penduduk' },
      { href: '/sumber#layanan', label: 'Rumah sakit dan sekolah' },
    ],
  },
  {
    title: 'Alam',
    links: [
      { href: '/sumber#alam', label: 'Bencana dan lahan' },
      { href: '/sumber#terkini', label: 'Cuaca dan udara' },
      { href: '/sumber#pemerintahan', label: 'Pemerintahan' },
    ],
  },
] as const;

const linkClass =
  'inline-flex min-h-11 items-center rounded-full text-sm font-semibold text-background/90 underline decoration-background/30 underline-offset-4 hover:decoration-background focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-highlight';
---

<footer class="mt-24 bg-foreground text-background">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1.2fr)] lg:gap-16">
      <div class="max-w-md">
        <a
          href="/"
          class="inline-flex min-h-11 items-center text-background"
          aria-label="JagaDaerah, beranda"
        >
          <Logo />
        </a>
        <p class="mt-6 text-2xl font-extrabold tracking-tight text-balance">
          Data resmi, dijelaskan apa adanya.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-background/75">
          JagaDaerah tidak menilai kinerja pemerintah daerah. Angka yang tidak ada dikosongkan.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/#cari"
            class="inline-flex min-h-11 items-center rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-highlight"
          >
            Pilih daerah
          </a>
          <a
            href="/sumber"
            class="inline-flex min-h-11 items-center rounded-full border border-background/30 px-5 text-sm font-semibold hover:bg-background/10 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-highlight"
          >
            Daftar sumber
          </a>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="text-xs font-bold tracking-[0.08em] text-background/60 uppercase">
              {column.title}
            </h2>
            <ul class="mt-2">
              {column.links.map((item) => (
                <li>
                  <a href={item.href} class={linkClass}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-12 border-t border-background/15 pt-6 text-sm leading-relaxed text-background/70">
      <p>
        Kode wilayah Kepmendagri No. 300.2.2-2138 jo. 300.2.2-2430 Tahun 2025. Batas peta
        disederhanakan dari data terbuka{' '}
        <a
          href="https://github.com/cahyadsn/wilayah_boundaries"
          class="underline decoration-background/40 underline-offset-4 hover:text-background hover:decoration-background"
          rel="noopener noreferrer"
        >
          wilayah_boundaries
        </a>{' '}
        (MIT) untuk tampilan.
      </p>
    </div>
  </div>
</footer>
