---
// A responsive national map with linked, sourced regional examples.
import mapData from '../../../public/data/map-regions.json';

const WIDTH = 720;
const scale = WIDTH / mapData.width;
const height = Math.round(mapData.height * scale);

function coarse(path: string): string {
  return path
    .split('Z')
    .filter((ring) => ring.length > 0)
    .map((ring) => {
      const points = [...ring.matchAll(/(-?[\d.]+),(-?[\d.]+)/g)].map(
        (match) =>
          `${Math.round(Number(match[1]) * scale)},${Math.round(Number(match[2]) * scale)}`,
      );
      const unique = points.filter((point, index) => index === 0 || point !== points[index - 1]);
      return unique.length < 3 ? '' : `M${unique.join('L')}Z`;
    })
    .join('');
}

const outline = mapData.provinces.map((province) => coarse(province.path)).join('');
const centres = new Map(mapData.regions.map((region) => [region.code, region]));

const EXAMPLES = [
  {
    code: '11.71',
    slug: 'kota-banda-aceh',
    name: 'Banda Aceh',
    figure: '97,0%',
    label: 'realisasi APBD · 2025',
  },
  {
    code: '96.01',
    slug: 'kabupaten-sorong',
    name: 'Kabupaten Sorong',
    figure: 'Rp69,56 miliar',
    label: 'bagi hasil SDA · 2025',
  },
  {
    code: '32.73',
    slug: 'kota-bandung',
    name: 'Kota Bandung',
    figure: '89,8%',
    label: 'realisasi APBD · 2025',
  },
] as const;

const annotations = EXAMPLES.flatMap((example, index) => {
  const region = centres.get(example.code);
  return region === undefined
    ? []
    : [
        {
          ...example,
          index,
          left: ((region.cx * scale + 6) / (WIDTH + 12)) * 100,
          top: ((region.cy * scale + 6) / (height + 12)) * 100,
        },
      ];
});
---

<figure class="map-illustration overflow-hidden rounded-[1.5rem] bg-[hsl(var(--map-sea))] px-4 pt-4 sm:rounded-[1.75rem] sm:px-6 sm:pt-5">
  <p class="px-1 text-xs font-semibold tracking-[0.12em] text-primary uppercase">
    Data wilayah · 2025
  </p>
  <div class="map-stage relative mt-2 px-2 sm:px-4">
    <svg
      viewBox={`-6 -6 ${WIDTH + 12} ${height + 12}`}
      class="hero-map block h-auto w-full"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d={outline}
        class="fill-[hsl(var(--primary)/0.14)] stroke-[hsl(var(--background))]"
        stroke-width="0.9"
      ></path>
    </svg>

    {annotations.map((annotation) => (
      <span
        class="map-point absolute"
        style={`left:${annotation.left}%;top:${annotation.top}%;--point-delay:${annotation.index * 220}ms`}
        aria-hidden="true"
      ></span>
    ))}
  </div>

  <ul class="grid border-t border-foreground/10 sm:grid-cols-3">
    {annotations.map((annotation) => (
      <li class="min-w-0 border-b border-foreground/10 last:border-b-0 sm:border-b-0 sm:border-l sm:first:border-l-0">
        <a
          href={`/daerah/${annotation.slug}`}
          class="grid min-h-16 w-full grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 px-1 py-3 text-left transition-colors hover:text-primary sm:min-h-20 sm:grid-cols-1 sm:content-center sm:gap-1 sm:px-4 sm:first:pl-1"
        >
          <span>
            <span class="block text-sm font-semibold">{annotation.name}</span>
            <span class="mt-0.5 block text-xs text-muted-foreground">{annotation.label}</span>
          </span>
          <span class="shrink-0 text-sm font-bold tabular-nums sm:self-start">
            {annotation.figure}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <figcaption class="py-3 text-xs leading-relaxed text-muted-foreground">
    Angka dari DJPK Kemenkeu. Pilih daerah untuk membuka profil beserta sumber datanya.
  </figcaption>
</figure>

<style>
  .map-point {
    width: 11px;
    height: 11px;
    margin: -5px 0 0 -5px;
    border: 2px solid hsl(var(--map-sea));
    border-radius: 50%;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 1px hsl(var(--primary) / 0.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .map-stage {
      animation: map-enter 700ms ease-out both;
    }

    .map-point::after {
      position: absolute;
      inset: -5px;
      border: 1px solid hsl(var(--primary) / 0.42);
      border-radius: inherit;
      content: '';
      animation: map-ripple 3.4s ease-out var(--point-delay) infinite;
    }

    @keyframes map-enter {
      from {
        opacity: 0;
        transform: translateY(7px);
      }
    }

    @keyframes map-ripple {
      from {
        transform: scale(0.6);
        opacity: 0.65;
      }
      to {
        transform: scale(2.3);
        opacity: 0;
      }
    }
  }
</style>
