---
import Container from '@/components/ui/Container.astro';

const ITEMS = [
  {
    title: 'Anggaran dan realisasi',
    body: 'Anggaran adalah rencana belanja dalam APBD. Realisasi adalah yang sudah dibayarkan. Persentase realisasi = realisasi ÷ anggaran.',
  },
  {
    title: 'Median nasional',
    body: 'Nilai tengah persentase realisasi semua kabupaten/kota yang datanya lengkap. Separuh daerah di atasnya, separuh di bawahnya.',
  },
  {
    title: 'Dana bagi hasil SDA',
    body: 'Bagian penerimaan negara dari minyak, gas, tambang, hutan, ikan, panas bumi, dan sawit yang ditransfer ke daerah. Bukan ukuran kekayaan alam.',
  },
  {
    title: 'Jumlah fasilitas di peta',
    body: 'Warna rumah sakit dan sekolah menunjukkan jumlah, bukan mutu dan bukan jumlah per penduduk. Daerah yang lebih besar biasanya terlihat lebih gelap.',
  },
  {
    title: 'Listrik',
    body: 'Rasio elektrifikasi 2024 diwarnai per provinsi. Nasional 99,83%. ESDM tidak menerbitkan angka per kabupaten/kota, jadi semua daerah dalam satu provinsi memakai angka provinsi itu.',
  },
  {
    title: 'Bencana tingkat provinsi',
    body: 'Data BNPB dirangkum per provinsi, jadi profil kabupaten/kota menampilkan kejadian bencana di provinsinya.',
  },
] as const;
---

<Container
  as="section"
  id="panduan"
  aria-labelledby="panduan-judul"
  class="mt-16 scroll-mt-24 sm:mt-24"
>
  <div class="max-w-2xl border-t border-border pt-8">
    <p class="text-sm font-semibold text-primary">Panduan</p>
    <h2 id="panduan-judul" class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
      Cara membaca angka
    </h2>
    <p class="mt-3 leading-relaxed text-muted-foreground">
      Enam istilah yang muncul di halaman ini. Bandingkan angka yang setahun dan setingkat.
    </p>
    <dl class="mt-6 divide-y divide-border border-t border-border">
      {ITEMS.map((item) => (
        <div class="py-4">
          <dt class="font-semibold tracking-tight">{item.title}</dt>
          <dd class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.body}</dd>
        </div>
      ))}
    </dl>
    <p class="border-t border-border pt-4 text-sm leading-relaxed text-muted-foreground">
      Kalau sumber belum melaporkan angka, yang tertulis “data belum tersedia”. Kosong bukan nol,
      dan bukan perkiraan.
    </p>
  </div>
</Container>
