---
// Recorded disaster history and statutory area for one kabupaten/kota, from two official publishers
// whose payloads already carry the Kemendagri region code:
//   - BIG: the statutory area of the region.
//   - BNPB: recorded disaster events and recorded impact, per hazard type.
// Static Astro, no island: the whole section is readable with JavaScript disabled.
//
// - Every figure is labelled with what it measures, its unit, its period/year and its publisher.
// - An absent value renders "Data belum tersedia", never 0. A published 0 stays 0.
// - Coverage is stated per sub-topic, so the page never implies national coverage it lacks.
// - Nothing here is re-derived, re-weighted, interpolated or scored, and no figure is a prediction
//   or a warning: these are historical records of what was reported.
import Disclosure from '@/components/ui/Disclosure.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { formatCount } from '@/lib/format';
import { NATURE } from '@/lib/nature';
import { table } from '@/components/ui/styles';

interface Props {
  regionCode: string;
  regionName: string;
}

const { regionCode, regionName } = Astro.props;
const record = NATURE.regions[regionCode];
const { big, bnpb, coverage } = NATURE.source;

const UNAVAILABLE = 'Data belum tersedia';
const FIRST_YEAR = 2010;
const LAST_YEAR = 2024;

// The published categories, in the order the artifact's label record declares. Reading the order
// from the data keeps the component in step with the contract, and the literal keys stay type-safe.
type Hazard = keyof typeof bnpb.hazard_labels;
type Impact = keyof typeof bnpb.impact_labels;
const HAZARD_ORDER = Object.keys(bnpb.hazard_labels) as Hazard[];
const IMPACT_ORDER = Object.keys(bnpb.impact_labels) as Impact[];

// Published hazard counts, largest first, ties keeping the publisher's own order. A hazard the
// source states as zero is still shown; one it omits is still absent.
const hazards = HAZARD_ORDER.flatMap((hazard) => {
  const value = record?.events_by_hazard?.[hazard];
  return value === undefined ? [] : [[hazard, value] as const];
}).toSorted(([, left], [, right]) => right - left);

const impacts = IMPACT_ORDER.flatMap((metric) => {
  const value = record?.impacts_2024?.[metric];
  return value === undefined ? [] : [[metric, value] as const];
});

// Recorded earthquakes get their own figure: the owner asked for gempa specifically.
const earthquakeEvents = record?.events_by_hazard?.gempabumi;
const earthquakeImpacts = IMPACT_ORDER.flatMap((metric) => {
  const value = record?.impacts_2024_by_hazard?.[`${metric}.gempabumi`];
  return value === undefined ? [] : [[metric, value] as const];
});

const years = Object.entries(record?.events_by_year ?? {}).toSorted(
  ([left], [right]) => Number(left) - Number(right),
);
const hazardTotal = hazards.reduce((sum, [, value]) => sum + value, 0);
const largestHazard = hazards[0]?.[1] ?? 0;
const largestYear = years.reduce((max, [, value]) => Math.max(max, value), 0);
const percent = (value: number, max: number) => (max === 0 ? 0 : Math.round((value / max) * 100));
---

<Section
  id="kondisi-alam"
  title="Riwayat bencana di daerah ini"
  meta={`BIG & BNPB · ${FIRST_YEAR}–${LAST_YEAR} · kabupaten/kota`}
  lead={`Kejadian yang pernah dicatat di ${regionName}. Bukan ramalan.`}
>
  <div class="rounded-2xl border border-border bg-card p-5 sm:p-6">
    <dl class="grid gap-6 sm:grid-cols-3">
      <Stat
        label="Luas wilayah (BIG)"
        value={record?.area ? formatCount(record.area.value) : null}
        unit={record?.area?.unit}
      />
      <Stat
        label={`Kejadian bencana ${LAST_YEAR}`}
        value={hazards.length > 0 ? formatCount(hazardTotal) : null}
        note="semua jenis bencana"
      />
      <Stat
        label={`Gempa bumi tercatat ${LAST_YEAR}`}
        value={earthquakeEvents === undefined ? null : formatCount(earthquakeEvents)}
        note="kejadian"
      />
    </dl>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 space-y-3">
      <h3 class="font-bold tracking-tight">Kejadian per jenis bencana, {LAST_YEAR}</h3>
      {hazards.length > 0 ? (
        <table class={table.root}>
          <caption class="sr-only">
            Jumlah kejadian bencana yang tercatat di {regionName} tahun {LAST_YEAR}, per jenis
            bencana, dari BNPB.
          </caption>
          <thead>
            <tr>
              <th scope="col">Jenis bencana</th>
              <th scope="col" class="pl-4 text-right!">
                Kejadian
              </th>
            </tr>
          </thead>
          <tbody>
            {hazards.map(([hazard, value]) => (
              <tr>
                <th scope="row">
                  {bnpb.hazard_labels[hazard] ?? hazard}
                  {/* Decoration for the number beside it; hidden from assistive technology. */}
                  <span aria-hidden="true" class="block h-2 rounded-full bg-muted mt-1.5">
                    <span
                      class="block h-full rounded-full bg-primary"
                      style={`width:${percent(value, largestHazard)}%`}
                    ></span>
                  </span>
                </th>
                <td class="pl-4 text-right!">{formatCount(value)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="text-muted-foreground" data-missing="events">
          {UNAVAILABLE}
        </p>
      )}
    </div>

    <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 space-y-3">
      <h3 class="font-bold tracking-tight">Dampak tercatat, {LAST_YEAR}</h3>
      {impacts.length > 0 ? (
        <table class={table.root}>
          <caption class="sr-only">
            Jumlah dampak bencana yang tercatat di {regionName} tahun {LAST_YEAR}, per jenis dampak,
            dari BNPB.
          </caption>
          <thead>
            <tr>
              <th scope="col">Jenis dampak</th>
              <th scope="col" class="pl-4 text-right!">
                Jumlah
              </th>
            </tr>
          </thead>
          <tbody>
            {impacts.map(([metric, value]) => (
              <tr>
                <th scope="row">
                  {bnpb.impact_labels[metric]}
                  <span class="text-xs leading-5 text-muted-foreground">
                    {' '}
                    · {bnpb.impact_units[metric]}
                  </span>
                </th>
                <td class="pl-4 text-right!">{formatCount(value)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="text-muted-foreground" data-missing="impacts">
          {UNAVAILABLE}
        </p>
      )}
      <p class="text-xs leading-5 text-muted-foreground">
        &ldquo;0&rdquo; berarti sumber menyatakan nol; &ldquo;{UNAVAILABLE}&rdquo; berarti sumber
        tidak menyatakannya.
      </p>
    </div>
  </div>

  <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 space-y-3">
    <h3 class="font-bold tracking-tight">
      Kejadian per tahun, {FIRST_YEAR}–{LAST_YEAR}
    </h3>
    {years.length > 0 ? (
      <>
        {/* Decorative overview; the same values are in the table inside the disclosure. */}
        <div aria-hidden="true">
          <div class="flex h-28 items-end gap-1">
            {years.map(([, value]) => (
              <span class="flex h-full flex-1 flex-col justify-end">
                <span
                  class="block rounded-t-sm bg-primary/70"
                  style={`height:${Math.max(percent(value, largestYear), value > 0 ? 3 : 0)}%`}
                ></span>
              </span>
            ))}
          </div>
          <div class="text-xs leading-5 text-muted-foreground mt-1 flex justify-between">
            <span>{years[0]?.[0]}</span>
            <span>{years[years.length - 1]?.[0]}</span>
          </div>
        </div>
        <Disclosure summary="Lihat angka per tahun">
          <table class={table.root}>
            <caption class="sr-only">
              Jumlah kejadian bencana yang tercatat di {regionName} per tahun, {FIRST_YEAR} sampai
              {LAST_YEAR}, semua jenis bencana, dari BNPB.
            </caption>
            <thead>
              <tr>
                <th scope="col">Tahun</th>
                <th scope="col" class="pl-4 text-right!">
                  Kejadian
                </th>
              </tr>
            </thead>
            <tbody>
              {years.map(([year, value]) => (
                <tr>
                  <th scope="row">{year}</th>
                  <td class="pl-4 text-right!">{formatCount(value)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </Disclosure>
      </>
    ) : (
      <p class="text-muted-foreground" data-missing="years">
        {UNAVAILABLE}
      </p>
    )}
  </div>

  {earthquakeEvents === undefined || earthquakeImpacts.length === 0 ? null : (
    <Disclosure summary={`Dampak gempa bumi tercatat, ${LAST_YEAR}`}>
      <table class={table.root}>
        <caption class="sr-only">
          Dampak gempa bumi yang tercatat di {regionName} tahun {LAST_YEAR}, dari BNPB.
        </caption>
        <thead>
          <tr>
            <th scope="col">Dampak tercatat</th>
            <th scope="col" class="pl-4 text-right!">
              Jumlah
            </th>
          </tr>
        </thead>
        <tbody>
          {earthquakeImpacts.map(([metric, value]) => (
            <tr>
              <th scope="row">{bnpb.impact_labels[metric]}</th>
              <td class="pl-4 text-right!">
                {formatCount(value)} <span class="text-xs">{bnpb.impact_units[metric]}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </Disclosure>
  )}

  <Disclosure summary="Cara membaca angka ini">
    <ul class="list-disc space-y-1 pl-5 text-sm text-muted-foreground">
      <li>
        Semua angka adalah <strong>catatan historis</strong> yang dilaporkan, bukan indeks risiko,
        peluang, prediksi, atau peringatan dini.
      </li>
      <li>
        Jumlah tercatat ikut ditentukan cara pencatatan tiap daerah: angka lebih tinggi tidak dengan
        sendirinya berarti lebih berbahaya, dan angka rendah atau nol tidak berarti aman.
      </li>
      <li>Daerah yang tidak ada di tabel sumber berarti sumber tidak menyatakan angkanya.</li>
      <li>
        Angka dampak hanya ditampilkan bila sumber memuat seluruh kolom jenis bencana, supaya tidak
        menjadi jumlah yang tidak lengkap.
      </li>
      <li>
        Indeks risiko resmi BNPB (InaRISK/IRBI) tidak ditampilkan karena ketentuannya tidak
        mengizinkan penggunaan ulang tanpa izin tertulis.
      </li>
    </ul>
  </Disclosure>

  <Fragment slot="source">
    <p>
      Luas wilayah: <ExternalLink href={big.url}>{big.publisher}</ExternalLink> — {big.title},
      satuan
      {big.unit}, menurut peraturan (bukan pengukuran ulang)
      {record?.area ? `, edisi ${record.area.edition}` : ''}. {big.unit_note}
      {big.license === null
        ? ' BIG tidak mencantumkan lisensi penggunaan ulang untuk layanan ini.'
        : ` Lisensi: ${big.license}.`}
    </p>
    <p>
      Kejadian dan dampak: <ExternalLink href={bnpb.url}>{bnpb.publisher}</ExternalLink> —{' '}
      {bnpb.title}. Lisensi {bnpb.license}. Diproses {NATURE.source.downloaded_at.slice(0, 10)}.
    </p>
    <p>
      Cakupan: luas {coverage.area.covered}/{coverage.area.total}; kejadian per jenis {LAST_YEAR}
      {coverage.events_by_hazard_2024.covered}/{coverage.events_by_hazard_2024.total}; dampak{' '}
      {LAST_YEAR}
      {coverage.impacts_2024.covered}/{coverage.impacts_2024.total}; seri tahunan{' '}
      {coverage.events_by_year.covered}/{coverage.events_by_year.total} kabupaten/kota.
    </p>
  </Fragment>
</Section>
