---
// Climate context for one kabupaten/kota: BMKG's monthly normal rainfall for 1981-2010, read at one
// reviewed sample point inside the region. Static HTML, no island. A climatological normal is not
// today's weather: that lives in the live "Kondisi terkini" section, and this one says so.
import type { RegionWeather } from '@jaga-daerah/contracts';
import { MONTH_NAMES } from '@jaga-daerah/contracts';

import Disclosure from '@/components/ui/Disclosure.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import Section from '@/components/ui/Section.astro';
import Stat from '@/components/ui/Stat.astro';
import { formatDate } from '@/lib/format';
import { WEATHER } from '@/lib/weather';
import { table } from '@/components/ui/styles';

interface Props {
  regionCode: string;
  regionName: string;
}

const { regionCode, regionName } = Astro.props;
const record: RegionWeather | undefined = WEATHER.regions[regionCode];
const unavailableReason = WEATHER.unavailable[regionCode];
const { source } = WEATHER;
const period = `${source.period_start}–${source.period_end}`;
const UNAVAILABLE = 'Data belum tersedia';

// Months in calendar order with their value, so the summary, chart, and table are built from the
// same read of the published record and can never disagree.
const monthRows = record
  ? MONTH_NAMES.map((name) => ({ name, value: record.monthly_mm[name] }))
  : [];
// A tie keeps the earlier month, which is the calendar order BMKG publishes.
const ranked = monthRows
  .filter(
    (row): row is { name: (typeof MONTH_NAMES)[number]; value: number } => row.value !== undefined,
  )
  .toSorted((left, right) => right.value - left.value);
const wettest = ranked[0];
const driest = ranked[ranked.length - 1];
const peak = wettest?.value ?? 0;

function millimetres(value: number): string {
  return value.toLocaleString('id-ID', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
}
---

<Section
  id="modul-cuaca"
  title="Iklim: curah hujan rata-rata"
  meta={`BMKG · normal ${period} · kabupaten/kota`}
  lead="Bulan yang biasanya paling basah dan paling kering. Rata-rata 30 tahun, bukan cuaca hari ini."
>
  {record ? (
    <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 space-y-6">
      <dl class="grid gap-6 sm:grid-cols-3">
        <Stat label="Total setahun" value={millimetres(record.annual_mm)} unit="mm" />
        <Stat
          label="Bulan terbasah"
          value={wettest?.name ?? null}
          note={wettest === undefined ? undefined : `${millimetres(wettest.value)} mm`}
        />
        <Stat
          label="Bulan terkering"
          value={driest?.name ?? null}
          note={driest === undefined ? undefined : `${millimetres(driest.value)} mm`}
        />
      </dl>

      {/* Decorative: every value is in the table below and the extremes are stated above. */}
      <figure aria-hidden="true">
        <div class="flex h-36 items-end gap-1 sm:gap-2">
          {monthRows.map((row) => (
            <span class="flex h-full flex-1 flex-col justify-end">
              <span
                class:list={[
                  'block rounded-t-md',
                  row.name === wettest?.name ? 'bg-primary' : 'bg-primary/45',
                ]}
                style={`height:${row.value === undefined || peak === 0 ? 0 : Math.max((row.value / peak) * 100, 3)}%`}
              ></span>
            </span>
          ))}
        </div>
        <div class="mt-1 flex gap-1 text-center text-[10px] text-muted-foreground sm:gap-2">
          {monthRows.map((row) => (
            <span class="flex-1">{row.name.slice(0, 3)}</span>
          ))}
        </div>
      </figure>

      <Disclosure summary="Lihat angka per bulan">
        <table class={table.root}>
          <caption class="sr-only">
            Normal curah hujan bulanan {regionName}, periode {period}, dalam milimeter, dari satu
            titik sampel di dalam wilayah.
          </caption>
          <thead>
            <tr>
              <th scope="col">Bulan</th>
              <th scope="col" class="pl-4 text-right!">
                Normal hujan (mm/bulan)
              </th>
            </tr>
          </thead>
          <tbody>
            {monthRows.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td class="pl-4 text-right!">
                  {row.value === undefined ? UNAVAILABLE : millimetres(row.value)}
                </td>
              </tr>
            ))}
            <tr class="font-semibold">
              <th scope="row" class="font-semibold!">
                Total satu tahun
              </th>
              <td class="pl-4 text-right!">{millimetres(record.annual_mm)}</td>
            </tr>
          </tbody>
        </table>
      </Disclosure>
    </div>
  ) : (
    <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 space-y-2 text-sm leading-relaxed">
      <p class="text-lg">{UNAVAILABLE}.</p>
      <p class="text-muted-foreground">
        {unavailableReason ??
          `Untuk ${regionName} pada periode ${period}, BMKG tidak menerbitkan angka yang dapat kami kutip.`}
      </p>
    </div>
  )}

  <Fragment slot="source">
    <p>
      Sumber: {source.publisher} — {source.title}. Atribusi: {source.attribution}. Diambil
      <time datetime={source.captured_at}>{formatDate(source.captured_at)}</time>.
      <ExternalLink href={source.url}>Produk sumber</ExternalLink> ·
      <ExternalLink href={source.license_url}>Ketentuan BMKG</ExternalLink>
    </p>
    <p>
      Metode: dibaca dari satu titik sampel di dalam wilayah
      {record
        ? ` (${record.sample_point.latitude.toFixed(4)}, ${record.sample_point.longitude.toFixed(4)})`
        : ''}
      ; daerah yang mencakup pesisir dan pegunungan bisa berbeda dari angka ini. Sidik jari snapshot
      SHA-256 <span class="font-mono break-all">{source.snapshot_checksum}</span>. Status penggunaan
      ulang: {source.license}
    </p>
  </Fragment>
</Section>
