---
// Declared wealth (LHKPN) published by KPK for the region's head in office. Static HTML: no figures
// are fetched at runtime. Every figure is labelled with its reporting year and the position held in
// that year, links to the official KPK publication, and is KPK's own net total (assets minus declared
// debt) — never presented as current wealth, and never as an audit result (docs/decisions/0003).
import type { LhkpnRegion } from '@jaga-daerah/contracts';

import Disclosure from '@/components/ui/Disclosure.astro';
import { formatDate, formatRupiahFull } from '@/lib/format';
import { LHKPN } from '@/lib/lhkpn';

interface Props {
  regionCode: string;
  regionName: string;
}

const { regionCode, regionName } = Astro.props;
const ELHKPN_URL = 'https://elhkpn.kpk.go.id/';
const record: LhkpnRegion | undefined = LHKPN.regions[regionCode];
// All captured years, newest first: a figure from an earlier office stays visible but is labelled with
// the position it belongs to, so it is never read as the incumbent's.
const history = record === undefined ? [] : [...record.reports].toReversed();
---

<section aria-labelledby="harta-kekayaan" class="scroll-mt-32 space-y-5">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <h2 id="harta-kekayaan" class="text-2xl font-extrabold tracking-[-0.03em] sm:text-3xl">
      Harta kekayaan pejabat
    </h2>
    <p class="inline-flex items-center gap-1.5 rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-muted-foreground">
      Sumber: KPK e-LHKPN
    </p>
  </div>

  {record === undefined ? (
    <>
      <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
        <p class="max-w-2xl text-muted-foreground">
          Belum ada salinan pengumuman KPK untuk {regionName}. Angkanya tetap di situs KPK.
        </p>
        <a
          href={ELHKPN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full font-semibold transition-colors px-4 text-sm bg-primary text-primary-foreground hover:bg-primary/90"
        >
          Cek di e-LHKPN KPK ↗<span class="sr-only"> (membuka tab baru)</span>
        </a>
      </div>
    </>
  ) : (
    <>
      <div class="rounded-2xl border border-border bg-card p-5 sm:p-6">
        <p class="text-sm text-muted-foreground">Pejabat dan lembaga</p>
        <p class="text-xl leading-tight font-extrabold tracking-tight break-words">
          {record.official}
        </p>
        <p class="mt-1 text-sm text-muted-foreground">{record.lembaga}</p>
        <p class="mt-4 text-xs text-muted-foreground">
          Total harta kekayaan tahun laporan terbaru untuk jabatan yang sedang diemban (
          {record.latest.position}): angka KPK di bawah ini adalah total bersih yang KPK sendiri
          terbitkan untuk tahun laporan tersebut, bukan harta terkini.
        </p>
      </div>

      <div class="rounded-2xl border border-border bg-card p-5 sm:p-6 border-primary/40 bg-accent/60">
        <p class="text-sm text-muted-foreground">
          Total harta kekayaan menurut KPK · tahun laporan {record.latest.year} · jabatan{' '}
          {record.latest.position}
        </p>
        <p class="mt-1 text-2xl font-extrabold tracking-tight break-words sm:text-3xl">
          {formatRupiahFull(record.latest.total_assets)}
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Jenis laporan: {record.latest.report_type} ·{' '}
          <a
            href={record.latest.source}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2"
          >
            Pengumuman resmi KPK
          </a>
          · diproses {formatDate(record.processed_at)}
        </p>
      </div>

      <div class="space-y-3">
        <h3 class="text-lg font-bold tracking-tight">
          {regionName}: seluruh tahun laporan yang tersedia
        </h3>
        <ul class="space-y-3">
          {history.map((report) => (
            <li class="rounded-2xl border border-border bg-card p-5 sm:p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="font-bold">
                  Tahun laporan {report.year} · {report.position}
                </p>
                <p class="font-extrabold tabular-nums break-words">
                  {formatRupiahFull(report.total_assets)}
                </p>
              </div>
              <p class="mt-1 text-xs text-muted-foreground">
                Jenis laporan: {report.report_type}
                {report.reported_on ? ` · dilaporkan ${report.reported_on}` : ''} ·{' '}
                <a
                  href={report.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-2"
                >
                  Pengumuman resmi KPK
                </a>
                · id pengumuman <span class="font-mono">{report.announcement_id}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>

      <Disclosure summary="Tentang angka ini">
        <div class="text-xs leading-5 text-muted-foreground space-y-2">
          <p>{record.notes}</p>
          <p>
            Sumber angka:{' '}
            <a
              href={LHKPN.source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2"
            >
              {LHKPN.source.publisher}, {LHKPN.source.title}
            </a>
            . JagaDaerah bukan penerbit angka ini, angka ini bukan hasil audit, dan tidak ada
            kesimpulan apa pun tentang penggunaan anggaran yang ditarik darinya. Halaman pengumuman
            disalin secara manual dari hasil pencarian e-Announcement; berkas simpanan{' '}
            <span class="font-mono">{record.capture_file}</span> (SHA-256{' '}
            <span class="font-mono">{record.capture_sha256.slice(0, 12)}…</span>) diunduh{' '}
            {formatDate(record.downloaded_at)}.
          </p>
          <p>
            Harta dan utang yang dideklarasikan disimpan KPK pada formulir LHKPN; yang ditampilkan
            di sini hanya total bersih yang KPK sendiri publikasikan, dan rincian aset serta utang
            tidak disalin. LHKPN bersifat tahunan, jadi satu angka mewakili periode 1 Januari–31
            Desember tahun laporan tersebut. Angka resmi lengkap:{' '}
            <a
              href={ELHKPN_URL}
              class="underline underline-offset-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              e-LHKPN KPK ↗<span class="sr-only"> (membuka tab baru)</span>
            </a>
          </p>
        </div>
      </Disclosure>
    </>
  )}
</section>
