---
// Mark: a map pin (daerah) holding three bars (data). Wordmark stacked, as in the brand sketch.
interface Props {
  size?: 'sm' | 'lg';
}

const { size = 'sm' } = Astro.props;
const large = size === 'lg';
---

<span class:list={['inline-flex items-center', large ? 'gap-3' : 'gap-2']}>
  <svg
    aria-hidden="true"
    viewBox="0 0 32 32"
    class:list={['shrink-0 text-primary', large ? 'size-14' : 'size-9']}
  >
    <path
      fill="currentColor"
      d="M16 1.5C8.8 1.5 3 7.1 3 14c0 9.1 13 16.5 13 16.5S29 23.1 29 14c0-6.9-5.8-12.5-13-12.5Z"
    ></path>
    <rect x="9.5" y="13" width="3.4" height="7" rx="1.2" fill="#fff"></rect>
    <rect x="14.3" y="8.5" width="3.4" height="11.5" rx="1.2" fill="#fff"></rect>
    <rect x="19.1" y="11" width="3.4" height="9" rx="1.2" fill="#fff"></rect>
  </svg>
  <span
    class:list={[
      'flex flex-col font-extrabold tracking-[-0.04em]',
      large ? 'text-4xl leading-[0.85]' : 'text-[1.05rem] leading-[0.9]',
    ]}
  >
    <span>Jaga</span>
    <span>Daerah</span>
  </span>
</span>
