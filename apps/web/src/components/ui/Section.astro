---
// One profile module: heading with its geographic level/period badge, an optional plain-language
// lead, the content, and a fine-print footer for sources and method notes (slot "source").
import Badge from '@/components/ui/Badge.astro';
import { finePrint, sectionTitle } from '@/components/ui/styles';

interface Props {
  id: string;
  title: string;
  /** Level and period, e.g. "BMKG · 1981–2010 · kabupaten/kota". Every figure needs one nearby. */
  meta?: string | undefined;
  lead?: string | undefined;
}

const { id, title, meta, lead } = Astro.props;
---

<section aria-labelledby={id} class="scroll-mt-32 space-y-5">
  <header class="space-y-2">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <h2 id={id} class={sectionTitle}>
        {title}
      </h2>
      {meta === undefined ? null : <Badge variant="ghost">{meta}</Badge>}
    </div>
    {lead === undefined ? null : <p class="max-w-3xl text-muted-foreground">{lead}</p>}
  </header>
  <slot />
  {Astro.slots.has('source') ? (
    <footer class:list={[finePrint, 'space-y-1 border-t border-border pt-4']}>
      <slot name="source" />
    </footer>
  ) : null}
</section>
