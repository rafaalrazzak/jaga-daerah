---
// Short reading aid placed before figures that are easy to misread.
import Surface from '@/components/ui/Surface.astro';

interface Props {
  title?: string | undefined;
}

const { title } = Astro.props;
---

<Surface tone="muted" class="text-sm leading-relaxed">
  <div role="note">
    {title === undefined ? null : <p class="font-semibold">{title}</p>}
    <div class:list={['space-y-1 text-muted-foreground', title !== undefined && 'mt-1']}>
      <slot />
    </div>
  </div>
</Surface>
