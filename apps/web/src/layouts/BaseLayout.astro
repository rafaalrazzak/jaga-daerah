---
import '@/styles/global.css';

import Logo from '@/components/Logo.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import ChatAssistant from '@/islands/ChatAssistant';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const NAV = [
  { href: '/#indonesia-sekarang', label: 'Kondisi terkini' },
  { href: '/#peta', label: 'Telusuri peta' },
  { href: '/#panduan', label: 'Cara membaca' },
  { href: '/bandingkan', label: 'Bandingkan' },
  { href: '/peringkat', label: 'Peringkat' },
  { href: '/sumber', label: 'Sumber' },
] as const;
// `Astro.site` is undefined unless astro.config sets `site` from PUBLIC_SITE_URL (no domain is final
// yet, PRD §16). Absolute URLs are emitted only when it is present, so a site-less build ships no
// canonical or og:url pointing at a guessed host.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-background antialiased">
    <a
      href="#konten"
      class="sr-only z-50 rounded-full bg-foreground px-4 py-3 font-semibold text-background focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Lewati ke konten utama
    </a>

    <header class="sticky top-0 z-40 border-b border-border bg-background/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
        <a
          href="/"
          class="inline-flex min-h-11 shrink-0 items-center"
          aria-label="JagaDaerah, beranda"
        >
          <Logo />
        </a>
        <nav aria-label="Utama" class="ml-auto hidden items-center gap-1 lg:flex">
          <ul class="flex items-center gap-1 text-sm font-semibold">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-11 items-center rounded-full px-3 whitespace-nowrap hover:bg-secondary"
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a
                href="/#cari"
                class="inline-flex min-h-11 items-center rounded-full bg-primary px-4 whitespace-nowrap text-primary-foreground hover:bg-primary/90"
              >
                Pilih daerah
              </a>
            </li>
          </ul>
        </nav>
        <details id="menu-situs" class="group relative ml-auto lg:hidden">
          <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-border px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
            <svg viewBox="0 0 20 20" class="size-5 group-open:hidden" aria-hidden="true">
              <path fill="currentColor" d="M3 5.5h14v1.5H3zm0 4h14v1.5H3zm0 4h14V15H3z"></path>
            </svg>
            <svg viewBox="0 0 20 20" class="hidden size-5 group-open:block" aria-hidden="true">
              <path
                fill="currentColor"
                d="M5.1 3.9 10 8.8l4.9-4.9 1.2 1.2L11.2 10l4.9 4.9-1.2 1.2L10 11.2l-4.9 4.9-1.2-1.2L8.8 10 3.9 5.1z"
              ></path>
            </svg>
            Menu
          </summary>
          <div class="absolute right-0 z-50 mt-2 w-[min(18rem,calc(100vw-2rem))] rounded-2xl border border-border bg-background p-2 shadow-lg">
            <ul class="grid text-sm font-semibold">
              {NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex min-h-11 items-center rounded-xl px-3 whitespace-nowrap hover:bg-secondary"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
            <a
              href="/#cari"
              class="mt-1 flex min-h-11 items-center justify-center rounded-full bg-primary px-4 font-semibold whitespace-nowrap text-primary-foreground hover:bg-primary/90"
            >
              Pilih daerah
            </a>
          </div>
        </details>
      </div>
      <script>
        const menu = document.querySelector('#menu-situs');
        if (menu instanceof HTMLDetailsElement) {
          for (const link of menu.querySelectorAll('a')) {
            link.addEventListener('click', () => {
              menu.open = false;
            });
          }
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') menu.open = false;
          });
          document.addEventListener('click', (event) => {
            if (!menu.open || !(event.target instanceof Node) || menu.contains(event.target))
              return;
            menu.open = false;
          });
        }
      </script>
    </header>

    <main id="konten" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <ChatAssistant client:idle />
  </body>
</html>
