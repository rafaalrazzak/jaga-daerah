---
import Container from '@/components/ui/Container.astro';
import Leaderboard from '@/islands/Leaderboard';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Peringkat Daerah — Transparansi Layanan & Bencana 514 Daerah | JagaDaerah"
  description="Peringkat 514 kabupaten dan kota di Indonesia berdasarkan ketersediaan rumah sakit, fasilitas sekolah, riwayat kejadian bencana BNPB, dan rekam jejak opini BPK RI."
>
  <div class="border-b border-border bg-card">
    <Container class="py-6 sm:py-10">
      <nav aria-label="Lokasi halaman" class="text-sm text-muted-foreground">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a
              href="/"
              class="inline-flex min-h-11 items-center underline-offset-4 hover:text-foreground hover:underline"
            >
              Beranda
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-foreground">
            Peringkat Daerah
          </li>
        </ol>
      </nav>

      <div class="mt-4 max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-primary">
          Data Terbuka Nasional
        </span>
        <h1 class="mt-4 text-[clamp(2rem,5vw,3.25rem)] leading-[1.08] font-extrabold tracking-tight text-balance">
          Peringkat Kabupaten & Kota
        </h1>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg">
          Pantau dan bandingkan peringkat 514 daerah di seluruh Indonesia berdasarkan ketersediaan
          fasilitas rumah sakit (SIRS Kemenkes), jumlah sekolah (Kemendikdasmen), kejadian bencana
          (BNPB), dan opini audit keuangan (BPK RI). Pilih total atau angka per 10.000 penduduk agar
          daerah kecil dan besar bisa dibandingkan lebih adil.
        </p>
      </div>
    </Container>
  </div>

  <Container class="py-8 sm:py-12">
    <Leaderboard client:load />
  </Container>
</BaseLayout>
