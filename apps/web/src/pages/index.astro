---
import HowToRead from '@/components/landing/HowToRead.astro';
import HeroMap from '@/components/landing/HeroMap.astro';
import Container from '@/components/ui/Container.astro';
import CoverageStats from '@/islands/CoverageStats';
import IndonesiaNow from '@/islands/IndonesiaNow';
import InteractiveMap from '@/islands/InteractiveMap';
import RegionSearch from '@/islands/RegionSearch';
import PinnedRegionBanner from '@/islands/PinnedRegionBanner';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { REGIONS } from '@/lib/regions';

const provinceCount = new Set(REGIONS.map((region) => region.province.code)).size;
const EXAMPLES = [
  { name: 'Bandung', slug: 'kota-bandung' },
  { name: 'Banda Aceh', slug: 'kota-banda-aceh' },
  { name: 'Kabupaten Sorong', slug: 'kabupaten-sorong' },
] as const;
---

<BaseLayout
  title="JagaDaerah — Kenali daerahmu lewat data yang mudah dipahami"
  description="Cari daerahmu dan pahami anggaran, pejabat, serta catatan bencana dari sumber resmi, dijelaskan dengan konteks yang mudah diikuti."
>
  <PinnedRegionBanner client:load />

  <Container as="section" class="pt-8 pb-12 sm:pt-14 sm:pb-16">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(22rem,0.86fr)_minmax(0,1.14fr)] lg:gap-14">
      <div class="max-w-xl py-2 sm:py-6">
        <p class="text-sm font-semibold tracking-wide text-primary">Anggaran · Pejabat · Bencana</p>
        <h1 class="mt-5 max-w-xl text-[clamp(2.65rem,5vw,4.75rem)] leading-[1.02] font-bold tracking-[-0.055em] text-balance">
          Lebih tahu tentang daerahmu.
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
          Data daerah dari sumber resmi, plus gempa dan peringatan dini BMKG untuk seluruh
          Indonesia.
        </p>

        <div id="cari" class="mt-8 scroll-mt-28">
          <h2 class="mb-2 text-sm font-semibold">Cari kabupaten atau kota</h2>
          <RegionSearch client:load />
          <noscript>
            <p class="mt-3 text-sm text-muted-foreground">
              Pencarian memerlukan JavaScript. Tautan contoh daerah tersedia di bawah.
            </p>
          </noscript>
        </div>

        <nav aria-label="Contoh daerah" class="mt-4">
          <p class="mb-1 text-xs text-muted-foreground">Contoh daerah</p>
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {EXAMPLES.map((region) => (
              <li>
                <a
                  href={`/daerah/${region.slug}`}
                  class="inline-flex min-h-11 items-center font-semibold text-primary underline decoration-primary/30 underline-offset-4 transition-colors hover:decoration-primary focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ring"
                >
                  {region.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <section aria-labelledby="hero-map-heading" class="min-w-0">
        <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 id="hero-map-heading" class="font-semibold tracking-tight">
              Peta daerah
            </h2>
            <p class="mt-1 text-sm text-muted-foreground">Contoh data · 2025</p>
          </div>
          <a
            href="#peta"
            class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-primary underline underline-offset-4 hover:decoration-2 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            Lihat peta anggaran <span aria-hidden="true">→</span>
          </a>
        </div>
        <HeroMap />
      </section>
    </div>

    <section
      id="indonesia-sekarang"
      aria-labelledby="indonesia-judul"
      class="mt-10 scroll-mt-28 sm:mt-14"
    >
      <div class="mb-4 max-w-2xl">
        <p class="text-sm font-semibold text-primary">Seluruh Indonesia</p>
        <h2 id="indonesia-judul" class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
          Kondisi terkini
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Gempa, peringatan dini cuaca, dan indeks udara stasiun. Bukan cuaca satu daerah.
        </p>
      </div>
      <IndonesiaNow client:load />
      <noscript>
        <p class="rounded-2xl border border-border bg-card p-5 text-sm">
          Kondisi terkini dimuat dengan JavaScript. Untuk gempa, peringatan, dan indeks udara resmi,
          buka
          <a
            href="https://www.bmkg.go.id/"
            class="font-semibold text-primary underline underline-offset-4"
          >
            bmkg.go.id
          </a>
          .
        </p>
      </noscript>
    </section>

    <section id="cakupan-data" class="mt-10 rounded-3xl bg-secondary p-5 sm:mt-14 sm:p-7">
      <CoverageStats client:idle provinces={provinceCount} regions={REGIONS.length} />
    </section>
  </Container>

  <Container class="mt-10 sm:mt-14">
    <section aria-labelledby="tentang-judul" class="max-w-2xl">
      <h2 id="tentang-judul" class="text-sm font-semibold text-primary">
        Dari mana angkanya
      </h2>
      <p class="mt-3 text-xl font-semibold leading-snug tracking-tight text-balance">
        Publikasi resmi, ditulis ulang supaya bisa dibaca tanpa tabel mentah.
      </p>
      <p class="mt-3 leading-relaxed text-muted-foreground">
        Anggaran dan dana bagi hasil dari DJPK Kemenkeu. Catatan bencana dari BNPB. Nama pejabat
        dari daftar yang tautannya ada di tiap profil. Tahun dan tingkat wilayah selalu berdiri di
        samping angka. JagaDaerah tidak menilai kinerja pemerintah daerah.
      </p>
    </section>
  </Container>

  <Container
    as="section"
    id="peta"
    aria-labelledby="peta-judul"
    class="mt-12 scroll-mt-24 sm:mt-16"
  >
    <div class="rounded-3xl bg-secondary p-5 sm:p-8">
      <div class="max-w-2xl pb-5">
        <p class="text-sm font-semibold text-primary">Persebaran per daerah</p>
        <h2 id="peta-judul" class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          Telusuri daerah di peta.
        </h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Pilih tahun, wilayah, lalu lapisannya. Warna membandingkan kabupaten dan kota. Angka
          listrik adalah rasio provinsi 2024, jadi kabupaten dan kota dalam satu provinsi berwarna
          sama.
        </p>
      </div>
      <div class="min-h-[24rem] rounded-2xl bg-background p-3 sm:p-5">
        <InteractiveMap client:visible />
        <noscript>
          <p class="text-lg">
            Peta interaktif memerlukan JavaScript. Gunakan pencarian daerah di atas.
          </p>
        </noscript>
      </div>
    </div>
  </Container>

  <HowToRead />
</BaseLayout>
