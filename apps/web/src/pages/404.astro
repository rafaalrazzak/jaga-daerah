---
import Container from '@/components/ui/Container.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman tidak ditemukan — JagaDaerah"
  description="Halaman yang Anda cari tidak ditemukan."
>
  <Container as="section" class="max-w-3xl pt-16">
    <p class="text-xs font-bold tracking-[0.08em] text-muted-foreground uppercase">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Halaman tidak ditemukan</h1>
    <p class="mt-5 text-lg text-muted-foreground">
      Alamat ini tidak ada. Cari kabupaten atau kota untuk membuka profilnya: kondisi terkini,
      pejabat, anggaran, dan riwayat bencana dari sumber resmi.
    </p>
    <a
      href="/#cari"
      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full font-semibold transition-colors px-4 text-sm bg-primary text-primary-foreground hover:bg-primary/90 mt-8"
    >
      Cari daerah
    </a>
  </Container>
</BaseLayout>
