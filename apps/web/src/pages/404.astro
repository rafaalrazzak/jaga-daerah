---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman tidak ditemukan — JagaDaerah"
  description="Halaman yang Anda cari tidak ditemukan."
>
  <section class="mx-auto max-w-3xl px-4 pt-16 sm:px-6">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 font-extrabold tracking-tight text-4xl sm:text-5xl">Halaman tidak ditemukan</h1>
    <p class="mt-5 text-lg text-muted-foreground">
      Alamat ini belum tersedia. Halaman profil setiap daerah sedang disiapkan dan akan memuat
      ringkasan anggaran serta risiko bencana dari sumber resmi.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-lg bg-ink px-5 font-semibold text-paper hover:bg-accent"
    >
      Kembali ke pencarian
    </a>
  </section>
</BaseLayout>
