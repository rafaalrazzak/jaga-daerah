---
import Container from '@/components/ui/Container.astro';
import CompareRegions from '@/islands/CompareRegions';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bandingkan 2 Daerah — Perbandingan Anggaran & Fasilitas Publik | JagaDaerah"
  description="Bandingkan anggaran APBD, belanja modal, belanja pegawai, fasilitas rumah sakit, sekolah, dan profil dua kabupaten/kota di Indonesia secara berdampingan dari data resmi."
>
  <div class="border-b border-border bg-card">
    <Container class="py-6 sm:py-10">
      <nav aria-label="Lokasi halaman" class="text-sm text-muted-foreground">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a
              href="/"
              class="inline-flex min-h-11 items-center underline-offset-4 hover:text-foreground hover:underline"
            >
              Beranda
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-foreground">
            Bandingkan Daerah
          </li>
        </ol>
      </nav>

      <div class="mt-4 max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-primary">
          Transparansi Publik
        </span>
        <h1 class="mt-4 text-[clamp(2rem,5vw,3.25rem)] leading-[1.08] font-extrabold tracking-tight text-balance">
          Bandingkan Dua Daerah
        </h1>
        <p class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg">
          Lihat perbedaan alokasi anggaran belanja APBD, porsi belanja pembangunan, fasilitas rumah
          sakit, sekolah, serta catatan bencana dua kabupaten/kota berdampingan dari data resmi
          pemerintah.
        </p>
      </div>
    </Container>
  </div>

  <Container class="py-8 sm:py-12">
    <CompareRegions client:load />
  </Container>
</BaseLayout>
